<mxfile host="drawio" agent="biochef-infra docs" version="24.0.0"><diagram id="security" name="Security connections"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1270" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="security-c1" value="&lt;b style='font-size:20px'&gt;Security connections&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;Every connection, who opens it, and how it is authenticated. Numbers match the table in deploy.md.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="340" height="48" as="geometry"/></mxCell><mxCell id="ext" value="External services · not run by BioChef" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="980" height="140" as="geometry"/></mxCell><mxCell id="dac" value='&lt;b&gt;DAC access system&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;REMS or EGA · issues visas&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="20" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="lsl" value='&lt;b&gt;LS Login&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Life Science AAI · upstream IdP&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Passport with visas&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="310" y="40" width="260" height="80" as="geometry"/></mxCell><mxCell id="ega" value='&lt;b&gt;CEGA / FEGA&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;htsget · EGA AAI token&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="700" y="40" width="260" height="80" as="geometry"/></mxCell><mxCell id="br" value="Researcher's browser" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="310" height="230" as="geometry"/></mxCell><mxCell id="security-c2" value="researcher" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="br"><mxGeometry x="20" y="50" width="30" height="52" as="geometry"/></mxCell><mxCell id="ebr" value='&lt;b&gt;editor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;biochef.app&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signs jobs, encrypts per node&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;member key locked by a passkey&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="br"><mxGeometry x="70" y="32" width="220" height="110" as="geometry"/></mxCell><mxCell id="gh" value="GitHub" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="310" height="330" as="geometry"/></mxCell><mxCell id="pages" value='&lt;b&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;serves the editor&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="40" width="270" height="56" as="geometry"/></mxCell><mxCell id="hubw" value='&lt;b&gt;tools hub workflows&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;build, sign, publish&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="110" width="270" height="56" as="geometry"/></mxCell><mxCell id="sig" value='&lt;b&gt;Sigstore&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Fulcio + Rekor · keyless signing&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="200" width="270" height="50" as="geometry"/></mxCell><mxCell id="adm" value="Operators" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="310" height="110" as="geometry"/></mxCell><mxCell id="security-c3" value="operator" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="adm"><mxGeometry x="20" y="30" width="26" height="46" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;IEETA network or VPN&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="adm"><mxGeometry x="70" y="28" width="220" height="56" as="geometry"/></mxCell><mxCell id="srv" value="Central server · make deploy" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="980" height="560" as="geometry"/></mxCell><mxCell id="caddy" value='&lt;b&gt;caddy :443 + host firewall&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;only 80/443 published&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;22 only from IEETA or the VPN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;TLS · HSTS · CSP · rate limits&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;hosts: auth. · coordinator. · coordinator. (people and mTLS) · registry.&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="srv"><mxGeometry x="30" y="100" width="230" height="220" as="geometry"/></mxCell><mxCell id="ssh" value='&lt;b&gt;sshd :22&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;admin tunnel&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="srv"><mxGeometry x="30" y="480" width="150" height="60" as="geometry"/></mxCell><mxCell id="net" value="network: internal · no published ports" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;dashed=1;dashPattern=6 4;" vertex="1" parent="srv"><mxGeometry x="380" y="30" width="580" height="510" as="geometry"/></mxCell><mxCell id="kc" value='&lt;b&gt;keycloak&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;realm biochef · LS Login broker&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;stores the broker tokens&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="net"><mxGeometry x="30" y="40" width="240" height="90" as="geometry"/></mxCell><mxCell id="kcdb" value='&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;keycloak&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="net"><mxGeometry x="300" y="50" width="130" height="70" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;coordinator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;people: Keycloak token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;sites: client certificate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;keeps envelopes; can't read jobs or partials&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="net"><mxGeometry x="30" y="170" width="240" height="100" as="geometry"/></mxCell><mxCell id="codb" value='&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;coordinator&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="net"><mxGeometry x="300" y="185" width="130" height="70" as="geometry"/></mxCell><mxCell id="reg" value='&lt;b&gt;global registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;read: anonymous&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;write: CI robot account only&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="net"><mxGeometry x="30" y="310" width="240" height="90" as="geometry"/></mxCell><mxCell id="security-c4" value='&lt;b&gt;never routed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;databases · Keycloak /admin ·&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Docker socket · monitoring ·&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;the agent API in any TRE&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#991b1b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="net"><mxGeometry x="300" y="310" width="260" height="170" as="geometry"/></mxCell><mxCell id="tre" value="TRE · make agent-deploy · no inbound connections" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="380" y="840" width="980" height="400" as="geometry"/></mxCell><mxCell id="eg" value='&lt;b&gt;egress firewall&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;allowlist: coordinator · registry (avenue A) · data service (remote mode)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="20" y="35" width="940" height="46" as="geometry"/></mxCell><mxCell id="ag" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;client certificate (federation PKI)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Hub certificate pinned · strict signing&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="40" y="120" width="260" height="100" as="geometry"/></mxCell><mxCell id="sreg" value='&lt;b&gt;silo registry · avenue B&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;synced, or an encrypted tar&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tre"><mxGeometry x="40" y="270" width="260" height="80" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;datasets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;read-only · never leave&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tre"><mxGeometry x="360" y="120" width="260" height="100" as="geometry"/></mxCell><mxCell id="pe" value="&lt;b&gt;Policy Engine + airlock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;barrier 1 · &lt;font color='#e11d48'&gt;&lt;b&gt;human step&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;then a signed, encrypted partial&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="360" y="260" width="260" height="90" as="geometry"/></mxCell><mxCell id="security-c5" value='&lt;b&gt;agent page&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;local only · data manager&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;node key never leaves&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="680" y="120" width="260" height="100" as="geometry"/></mxCell><mxCell id="security-c6" value='&lt;b&gt;what leaves&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;agent states (alive, running, waiting, error)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;encrypted partials · never logs&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fffbeb;strokeColor=#d6b656;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;shape=note;size=12;" vertex="1" parent="tre"><mxGeometry x="680" y="260" width="260" height="90" as="geometry"/></mxCell><mxCell id="security-c7" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#2563eb'&gt;━━▶&lt;/font&gt; person's token (OIDC, Keycloak)&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#059669'&gt;━━▶&lt;/font&gt; mTLS client certificate&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━▶&lt;/font&gt; anonymous, no secret&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#7c3aed'&gt;━━▶&lt;/font&gt; CI credentials&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#ea580c'&gt;━━▶&lt;/font&gt; admin, IEETA or VPN only&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#92400e'&gt;╍╍▶&lt;/font&gt; data-service token (remote mode)&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style='margin:2px 0'&gt;Arrows start where the connection opens.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1400" y="50" width="300" height="166" as="geometry"/></mxCell><mxCell id="security-c8" value="&lt;b&gt;Connections&lt;/b&gt;&lt;div style='margin:3px 0'&gt;① page load from GitHub Pages&lt;/div&gt;&lt;div style='margin:3px 0'&gt;② login: OIDC code + PKCE, public client&lt;/div&gt;&lt;div style='margin:3px 0'&gt;③ Keycloak → LS Login: brokered login, confidential client; tokens stored&lt;/div&gt;&lt;div style='margin:3px 0'&gt;④ studies, jobs, partials with the Keycloak token; jobs signed and encrypted per node&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑤ coordinator checks tokens against Keycloak's JWKS&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑥ catalogue, site list, descriptors, tools: anonymous read&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑦ agent polls over mTLS: states, tasks, encrypted partials&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑧ agent pulls tools by digest, verifies offline (avenue A)&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑨ htsget with the EGA token carried in the job (remote mode)&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑩ CI pushes tools with the registry robot account&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑪ CI signs keyless with GitHub OIDC&lt;/div&gt;&lt;div style='margin:3px 0'&gt;⑫ SSH from IEETA or the VPN; databases via tunnel&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;verticalAlign=top;spacingLeft=8;spacingTop=6;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1400" y="300" width="300" height="330" as="geometry"/></mxCell><mxCell id="security-c9" value="①" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#334155;fontColor=#334155;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.47;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ebr" target="pages"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security-c10" value="② ④ ⑥ :443" style="html=1;rounded=1;fontSize=10;labelBac