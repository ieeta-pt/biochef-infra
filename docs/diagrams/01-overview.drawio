<mxfile host="drawio" agent="biochef-infra docs" version="24.0.0"><diagram id="overview" name="Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="830" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="overview-c1" value="&lt;b style='font-size:20px'&gt;BioChef at a glance: three places, three targets&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;biochef-infra brings everything up on a laptop, deploys the central unit, and installs the agent in each TRE.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="48" as="geometry"/></mxCell><mxCell id="gh" value="GitHub" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1420" height="140" as="geometry"/></mxCell><mxCell id="overview-c2" value='&lt;b&gt;component repos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;app · agent · hub · recipes&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="hubw" value='&lt;b&gt;tools hub workflows&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;build, sign and publish tools&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="320" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="orc" value='&lt;b&gt;biochef-infra&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;make up · make deploy · make agent-deploy&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;submodules pinned · compose files · docs&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="960" y="35" width="440" height="80" as="geometry"/></mxCell><mxCell id="lap" value="Laptop · make up (= make local)" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="420" height="300" as="geometry"/></mxCell><mxCell id="overview-c3" value='&lt;b&gt;the whole stack, locally&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;editor · registry · coordinator · Keycloak&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;simulated silos with synthetic data&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;everything on 127.0.0.1&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;the local TRE we test on first&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="lap"><mxGeometry x="20" y="45" width="380" height="200" as="geometry"/></mxCell><mxCell id="cen" value="Central server · make deploy" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="460" height="300" as="geometry"/></mxCell><mxCell id="cbox" value='&lt;b&gt;main deploy app&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;coordinator (Coordination Hub) + Postgres&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;global registry + catalogue&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Keycloak, brokering LS Login&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;caddy: the only door&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="cen"><mxGeometry x="20" y="45" width="420" height="200" as="geometry"/></mxCell><mxCell id="tre" value="Each TRE · make agent-deploy" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="1040" y="280" width="420" height="300" as="geometry"/></mxCell><mxCell id="tbox" value='&lt;b&gt;agent bundle&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;agent · local policy · node key&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Policy Engine + airlock&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;optional silo registry&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="20" y="45" width="380" height="200" as="geometry"/></mxCell><mxCell id="br" value="Browser" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="460" height="150" as="geometry"/></mxCell><mxCell id="ed" value='&lt;b&gt;editor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;biochef.app&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signs and encrypts jobs&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="br"><mxGeometry x="20" y="40" width="420" height="80" as="geometry"/></mxCell><mxCell id="ext" value="External" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="420" height="150" as="geometry"/></mxCell><mxCell id="lsl" value="&lt;b&gt;LS Login&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="20" y="50" width="120" height="64" as="geometry"/></mxCell><mxCell id="ega" value="&lt;b&gt;CEGA / FEGA&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="160" y="50" width="120" height="64" as="geometry"/></mxCell><mxCell id="overview-c4" value='&lt;b&gt;DACs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;visas&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="300" y="50" width="100" height="64" as="geometry"/></mxCell><mxCell id="overview-c5" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━━▶&lt;/font&gt; request, starts at whoever opens the connection&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;╍╍╍▷&lt;/font&gt; what comes back&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#2563eb'&gt;■&lt;/font&gt; BioChef central &amp;nbsp; &lt;font color='#059669'&gt;■&lt;/font&gt; inside a TRE / silo&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#ea580c'&gt;■&lt;/font&gt; external service &amp;nbsp; &lt;font color='#7c3aed'&gt;■&lt;/font&gt; CI &amp;nbsp; &lt;font color='#ca8a04'&gt;■&lt;/font&gt; browser&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="420" height="115" as="geometry"/></mxCell><mxCell id="overview-c6" value="push signed tools" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#7c3aed