Cell><mxCell id="agent-c3" value='&lt;b&gt;node descriptor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signed by the node · public&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;published in the global registry&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="inst"><mxGeometry x="20" y="180" width="250" height="90" as="geometry"/></mxCell><mxCell id="op" value='&lt;b&gt;node operator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;brings tools in as an encrypted tar&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;(avenue B, no network)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="inst"><mxGeometry x="20" y="390" width="250" height="90" as="geometry"/></mxCell><mxCell id="tre" value="TRE perimeter · no inbound connections" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="inst"><mxGeometry x="300" y="20" width="1340" height="800" as="geometry"/></mxCell><mxCell id="eg" value='&lt;b&gt;egress firewall&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;allowlist: coordinator · registry (avenue A) · data service (remote mode)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="20" y="40" width="1290" height="46" as="geometry"/