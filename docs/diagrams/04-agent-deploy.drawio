 height="90" as="geometry"/></mxCell><mxCell id="ag" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;agent#73 image · Apptainer · cosign&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;strict signing · polls, never listens outside&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="370" y="130" width="300" height="110" as="geometry"/></mxCell><mxCell id="steps" value='&lt;b&gt;workflow steps&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Snakemake · each step in Apptainer, no network&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;SLURM queue on a cluster&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="370" y="390" width="300" height="84" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;datasets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;read-only · path from local policy&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;never leave the TRE&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tre"><mxGeometry x="370" y="540" width="300" height="90" as="geometry"/></mxCell><mxCell id="pol" value='&lt;b&gt;local policy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;approved studies and workflows&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;visa issuers · dataset → path&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tre"><mxGeometry x="720" y="130" width="280" height="84" as="geometry"/></mxCell><mxCell id="agent-c5" value='&lt;b&gt;trusted root + base image&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Sigstore root, local .sif&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;for offline checks&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tre"><mxGeometry x="720" y="250" width="280" height="84" as="geometry"/></mxCell><mxCell id="pe" value='&lt;b&gt;Policy Engine&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;barrier 1: only aggregates, minimum counts&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="720" y="390" width="280" height="70" as="geometry"/></mxCell><mxCell id="air" value="&lt;b&gt;airlock reviewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;&lt;font color='#e11d48'&gt;&lt;b&gt;human step&lt;/b&gt;&lt;/font&gt;, if the TRE has one&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tre"><mxGeometry x="720" y="500" width="280" height="70" as="geometry"/></mxCell><mxCell id="agent-c6" value='&lt;b&gt;what leaves&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;agent states only: alive, running, waiting, error&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;partials: signed by the node, encrypted for members&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;never logs or step output&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fffbeb;strokeColor=#d6b656;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;shape=note;size=12;" vertex="1" parent="tre"><mxGeometry x="720" y="630" width="280" height="120" as="geometry"/></mxCell><mxCell id="agent-c7" value="&lt;b&gt;Runtime variants&lt;/b&gt; (chosen in the TRE's .env)&lt;div&gt;· &lt;b&gt;compose&lt;/b&gt;: docker or podman; steps in Apptainer&lt;/div&gt;&lt;div&gt;· &lt;b&gt;cluster&lt;/b&gt;: Apptainer + systemd; steps on SLURM&lt;/div&gt;&lt;br&gt;&lt;b&gt;Registry avenues&lt;/b&gt; (per TRE)&lt;div&gt;· &lt;b&gt;A&lt;/b&gt;: pull from the global registry&lt;/div&gt;&lt;div&gt;· &lt;b&gt;B&lt;/b&gt;: own silo registry; egress only to the coordinator&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fffbeb;strokeColor=#d6b656;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;shape=note;size=12;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="tre"><mxGeometry x="1040" y="130" width="280" height="260" as="geometry"/></mxCell><mxCell id="agent-c8" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━━▶&lt;/font&gt; request, starts at whoever opens the connection&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;╍╍╍▷&lt;/font&gt; what comes back&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#2563eb'&gt;■&lt;/font&gt; BioChef central &amp;nbsp; &lt;font color='#059669'&gt;■&lt;/font&gt; inside a TRE / silo&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#ea580c'&gt;■&lt;/font&gt; external service &amp;nbsp; &lt;font color='#7c3aed'&gt;■&lt;/font&gt; CI &amp;nbsp; &lt;font color='#ca8a04'&gt;■&lt;/font&gt; browser&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1360" y="670" width="280" height="115" as="geometry"/></mxCell><mxCell id="agent-c9" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#334155;fontColor=#334155;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3876;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag" target="eg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agent-c10" value="mTLS poll · encrypted task · partial · states" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#059669;fontColor=#059669;exitX=0.1783;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg" target="co"><mxGeometry relative="1" as="geometry" x="0.6"></mxGeometry></mxCell><mxCell id="agent-c11" value="OCI pull by digest (A)" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeColor=#334155;fontColor=#334155;exitX=0.4109;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="eg" target="reg"><mxGeometry relative="1" as="geometry" x="0.6"></mxGeometry></mxCell><mxCell id="agent-c12" value="htsget (remote mode)" style="html=1;ro