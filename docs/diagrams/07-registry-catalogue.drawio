<mxfile host="drawio" agent="biochef-infra docs" version="24.0.0"><diagram id="registry" name="Registry and catalogue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="registry-c1" value="&lt;b style='font-size:20px'&gt;Tools and silo information&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;One global registry for the editor and the catalogue; each TRE picks avenue A or B for tools.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="48" as="geometry"/></mxCell><mxCell id="gh" value="GitHub" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="320" height="300" as="geometry"/></mxCell><mxCell id="rec" value='&lt;b&gt;biochef-recipes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;merge to the default branch&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="40" width="280" height="60" as="geometry"/></mxCell><mxCell id="hub" value='&lt;b&gt;tools hub CI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;validate, build, test&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;cosign keyless · SLSA · SBOM&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signs the catalogue (ES256)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="gh"><mxGeometry x="20" y="140" width="280" height="110" as="geometry"/></mxCell><mxCell id="dm" value="&lt;b&gt;each node's data manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;signs the node descriptor:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#475569&quot;&gt;datasets, execution models, allowed tools&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="320" height="100" as="geometry"/></mxCell><mxCell id="reg" value="Global registry · registry.biochef.app · part of make deploy" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="520" height="620" as="geometry"/></mxCell><mxCell id="tools" value='&lt;b&gt;tools&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;WASM for the editor&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;native for agents · by digest&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="reg"><mxGeometry x="30" y="50" width="220" height="84" as="geometry"/></mxCell><mxCell id="registry-c2" value='&lt;b&gt;tool catalogue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signed (ES256)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="reg"><mxGeometry x="280" y="50" width="210" height="84" as="geometry"/></mxCell><mxCell id="registry-c3" value='&lt;b&gt;site list&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signed by the federation root&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;nodes, keys, endpoints, editor digests&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="reg"><mxGeometry x="30" y="180" width="220" height="84" as="geometry"/></mxCell><mxCell id="desc" value='&lt;b&gt;node descriptors&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signed by each node · public&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="reg"><mxGeometry x="280" y="180" width="210" height="84" as="geometry"/></mxCell><mxCell id="registry-c4" value='&lt;b&gt;dataset metadata&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;what each silo holds, never data&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="reg"><mxGeometry x="30" y="310" width="220" height="84" as="geometry"/></mxCell><mxCell id="registry-c5" value='&lt;b&gt;synthetic datasets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;for designing and testing workflows&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="reg"><mxGeometry x="280" y="310" width="210" height="84" as="geometry"/></mxCell><mxCell id="registry-c6" value="Read anonymously. The 15 Oct meeting agreed one global central registry, with endpoints and datasets for synthetic tests and the researchers' tools." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#1e3a8a;spacing=2;" vertex="1" parent="reg"><mxGeometry x="30" y="530" width="460" height="70" as="geometry"/></mxCell><mxCell id="br" value="Browser" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="340" height="250" as="geometry"/></mxCell><mxCell id="ed" value='&lt;b&gt;editor: catalogue view&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;shows the silos and their datasets&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;offers only the tools the selected TREs can run&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;design and test on synthetic data&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="br"><mxGeometry x="20" y="40" width="300" height="170" as="geometry"/></mxCell><mxCell id="ta" value="TRE on avenue A: the global registry" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="560" height="260" as="geometry"/></mxCell><mxCell id="aga" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;verifies cosign, SBOM, SLSA offline&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ta"><mxGeometry x="30" y="70" width="240" height="90" as="geometry"/></mxCell><mxCell id="ega" value='&lt;b&gt;egress allowlist&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;registry + coordinator&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ta"><mxGeometry x="320" y="70" width="210" height="90" as="geometry"/></mxCell><mxCell id="tb" value="TRE on avenue B: its own registry" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="680" height="260" as="geometry"/></mxCell><mxCell id="agb" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;verifies offline, the same way&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tb"><mxGeometry x="30" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="sreg" value='&lt;b&gt;silo registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;only the tools this TRE allows&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="tb"><mxGeometry x="270" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="op" value='&lt;b&gt;operator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;encrypted tar&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tb"><mxGeometry x="510" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="egb" value='&lt;b&gt;egress&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;coordinator, and the sync&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="tb"><mxGeometry x="510" y="150" width="150" height="80" as="geometry"/></mxCell><mxCell id="registry-c7" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━━▶&lt;/font&gt; request, starts at whoever opens the connection&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;╍╍╍▷&lt;/font&gt; what comes back&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#2563eb'&gt;■&lt;/font&gt; BioChef central &amp;nbsp; &lt;font color='#059669'&gt;■&lt;/font&gt; inside a TRE / silo&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#ea580c'&gt;■&lt;/font&gt; external service &amp;nbsp; &lt;font color='#7c3aed'&gt;■&lt;/font&gt; CI &amp;nbsp; &lt;font color='#ca8a04'&gt;■&lt;/font&gt; browser&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=10;