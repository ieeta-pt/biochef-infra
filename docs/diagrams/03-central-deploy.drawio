<mxfile host="drawio" agent="biochef-infra docs" version="24.0.0"><diagram id="central" name="Central deploy"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="990" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="central-c1" value="&lt;b style='font-size:20px'&gt;Central deploy: make deploy&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;The main deploy app: coordinator, global registry + catalogue and Keycloak on one server, behind one door. Never the agent.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="48" as="geometry"/></mxCell><mxCell id="br" value="Browser" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="200" as="geometry"/></mxCell><mxCell id="central-c2" value="Researcher" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="br"><mxGeometry x="20" y="40" width="30" height="52" as="geometry"/></mxCell><mxCell id="ebr" value='&lt;b&gt;editor in the browser&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;biochef.app · signed release&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;signs and encrypts jobs&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#0f172a;align=center;verticalAlign=middle;spaci