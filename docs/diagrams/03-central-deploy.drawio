ap;fontSize=11;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="net"><mxGeometry x="310" y="460" width="170" height="70" as="geometry"/></mxCell><mxCell id="central-c4" value='&lt;b&gt;never routed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;databases · Keycloak /admin · Docker socket · monitoring&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;reach them through an SSH tunnel&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#991b1b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="net"><mxGeometry x="30" y="650" width="450" height="110" as="geometry"/></mxCell><mxCell id="ext" value="External" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1350" y="440" width="320" height="150" as="geometry"/></mxCell><mxCell id="lsl" value='&lt;b&gt;LS Login&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Life Science AAI&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;upstream identity provider&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="20" y="50" width="280" height="74" as="geometry"/></mxCell><mxCell id="bk" value='&lt;b&gt;off-site backups&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;nightly: both databases + registry-data&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1350" y="640" width="320" height="70" as="geometry"/></mxCell><mxCell id="central-c5" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━━▶&lt;/font&gt; request, starts at whoever opens the connection&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;╍╍╍▷&lt;/font&gt; what comes back&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#2563eb'&gt;■&lt;/font&gt; BioChef central &amp;nbsp; &lt;font color='#059669'&gt;■&lt;/font&gt; inside a TRE / silo&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#ea580c'&gt;■&lt;/font&gt; external service &amp;nbsp; &lt;font color='#7c3aed'&gt;■&lt;/font&gt; CI &amp;nbsp; &lt;font color='#ca8a04'&gt;■&lt;/font&gt; browser&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1350" y="80" width="330" height="115" as="geometry"/></mxCell><mxCell id="central-c6" value="&lt;b&gt;Staging&lt;/b&gt; is the same stack: make deploy on the staging server, whose .env selects staging. Reachable only from the VPN; its own catalogue key." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="1350" y="750" width="330" height="90" as="geometry"/></mxCell><mxCell id="central-c7" value="page" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;endSize=7;jumpStyle=