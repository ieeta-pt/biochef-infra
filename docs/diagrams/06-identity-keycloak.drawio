<mxfile host="drawio" agent="biochef-infra docs" version="24.0.0"><diagram id="identity" name="Who trusts whom"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="identity-c1" value="&lt;b style='font-size:20px'&gt;Identity: Keycloak in front of LS Login&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;Researchers keep logging in with LS Login (agreed on 15 Oct); BioChef's Keycloak brokers it. Nodes authenticate with mTLS.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#0f172a;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1100" height="48" as="geometry"/></mxCell><mxCell id="ext" value="External" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="780" height="160" as="geometry"/></mxCell><mxCell id="home" value='&lt;b&gt;home institution IdP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;via eduGAIN, or ORCID, Google&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#ea580c;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="ext"><mxGeometry x="20" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="lsl" value='&lt;b&gt;LS Login&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;Passport broker&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;login.aai.lifescience-ri.eu&lt;/font&gt;' style="html=1;