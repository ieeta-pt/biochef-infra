eight="64" as="geometry"/></mxCell><mxCell id="hub" value='&lt;b&gt;tools hub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;make recipes · biochef-hub&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;publishes to the registry&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#7c3aed;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="dev"><mxGeometry x="50" y="335" width="170" height="70" as="geometry"/></mxCell><mxCell id="eg" value='&lt;b&gt;egress proxy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;allowlist: registry, coordinator&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;anything else gets a 403&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#78350f;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="lap"><mxGeometry x="700" y="528" width="260" height="72" as="geometry"/></mxCell><mxCell id="sa" value="Silo A · internal network · registry avenue A" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="lap"><mxGeometry x="20" y="630" width="800" height="340" as="geometry"/></mxCell><mxCell id="sh" value='&lt;b&gt;shell&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;make shell · runs in stage 1&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="sa"><mxGeometry x="30" y="50" width="200" height="64" as="geometry"/></mxCell><mxCell id="ag" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;built from biochef-agent (agent#73 Dockerfile)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;no published port&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="sa"><mxGeometry x="280" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="pol" value='&lt;b&gt;local policy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;studies, workflows, issuers,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;dataset ID → path&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="sa"><mxGeometry x="30" y="155" width="200" height="80" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;synthetic data store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;files + metadata DB, read-only&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;seeded by make up&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="sa"><mxGeometry x="280" y="160" width="220" height="84" as="geometry"/></mxCell><mxCell id="pe" value='&lt;b&gt;Policy Engine&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;stub until built&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="sa"><mxGeometry x="560" y="50" width="210" height="64" as="geometry"/></mxCell><mxCell id="air" value='&lt;b&gt;airlock&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;stub: approves locally&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#64748b;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=5 3;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="sa"><mxGeometry x="560" y="155" width="210" height="64" as="geometry"/></mxCell><mxCell id="local-c3" value="Jobs carry dataset IDs, never files. Local policy maps each ID to a path inside the silo." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#065f46;spacing=2;" vertex="1" parent="sa"><mxGeometry x="20" y="265" width="760" height="40" as="geometry"/></mxCell><mxCell id="sb" value="Silo B · stage 3 · internal network · avenue B: own registry" style="rounded=1;arcSize=3;absoluteArcSize=1;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;" vertex="1" parent="lap"><mxGeometry x="860" y="630" width="780" height="340" as="geometry"/></mxCell><mxCell id="sreg" value='&lt;b&gt;silo registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;only the tools this silo allows&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;synced through the proxy&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="sb"><mxGeometry x="20" y="50" width="200" height="84" as="geometry"/></mxCell><mxCell id="agb" value='&lt;b&gt;agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;same image and bundle as silo A&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="sb"><mxGeometry x="280" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="polb" value='&lt;b&gt;local policy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;its own studies and issuers&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="sb"><mxGeometry x="540" y="50" width="220" height="74" as="geometry"/></mxCell><mxCell id="datab" value='&lt;b&gt;synthetic data store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#475569"&gt;different synthetic cohort&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#059669;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=4;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;" vertex="1" parent="sb"><mxGeometry x="280" y="160" width="220" height="84" as="geometry"/></mxCell><mxCell id="local-c4" value="Same Policy Engine and airlock stubs as silo A. The agent's only outside connection is the coordinator; tools come from the silo registry." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#065f46;spacing=2;" vertex="1" parent="sb"><mxGeometry x="20" y="265" width="740" height="40" as="geometry"/></mxCell><mxCell id="local-c5" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;━━━▶&lt;/font&gt; request, starts at whoever opens the connection&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#334155'&gt;╍╍╍▷&lt;/font&gt; what comes back&lt;/div&gt;&lt;div style='margin:2px 0'&gt;&lt;font color='#94a3b8'&gt;╍╍╍▶&lt;/font&gt; not built yet, or optional&lt;/div&gt;&lt;div style=